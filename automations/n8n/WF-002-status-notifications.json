{
  "name": "WF-002 - Status notifications",
  "id": "wf002-s2-s6",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "citas-status",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wf002-webhook",
      "name": "Appointment status event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [220, 300],
      "webhookId": "wf002-citas-status"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{$json.eventType}}",
              "rightValue": "APPOINTMENT_STATUS_CHANGED",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "leftValue": "={{$json.status}}",
              "rightValue": "APPROVED",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "wf002-approved",
      "name": "Approved event",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{$json.recipientEmail}}",
        "subject": "Cita aprobada - FCV Demo",
        "message": "={{'Tu cita sintética fue aprobada. Id: ' + $json.appointmentId}}"
      },
      "id": "wf002-gmail-approved",
      "name": "Notify approved",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [760, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { accepted: true, workflow: 'WF-002', correlationId: $json.correlationId || null } }}",
        "options": { "responseCode": 202 }
      },
      "id": "wf002-response",
      "name": "Deterministic response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1040, 300]
    }
  ],
  "connections": {
    "Appointment status event": {
      "main": [[{ "node": "Approved event", "type": "main", "index": 0 }]]
    },
    "Approved event": {
      "main": [
        [{ "node": "Notify approved", "type": "main", "index": 0 }],
        [{ "node": "Deterministic response", "type": "main", "index": 0 }]
      ]
    },
    "Notify approved": {
      "main": [[{ "node": "Deterministic response", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "wf002-s2-s6",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
